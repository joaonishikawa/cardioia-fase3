  {
    "id": "regras",
    "type": "function",
    "z": "tab",
    "name": "Regras clínicas",
    "func": "// Fog: valida a mensagem e aplica as regras clínicas. O broker é público, então nada é confiável.\nconst d = msg.payload;\nconst ok = d && typeof d === \"object\"\n    && Number.isFinite(d.temp) && d.temp >= -40 && d.temp <= 80\n    && Number.isFinite(d.umid) && d.umid >= 0 && d.umid <= 100\n    && Number.isInteger(d.bpm) && d.bpm >= 0 && d.bpm <= 300\n    && Number.isInteger(d.idade_s) && d.idade_s >= 0\n    && Number.isInteger(d.pendentes) && d.pendentes >= 0;\nif (!ok) {\n    node.warn(\"Mensagem inválida descartada\");\n    return null;\n}\n\nconst LIMITES = { tempMax: 38, bpmMax: 120, bpmMin: 50 };\nconst AO_VIVO_S = 15;\n\n// Amostras sincronizadas entram no gráfico no horário em que foram medidas\nconst timestamp = Date.now() - d.idade_s * 1000;\n\nconst motivos = [];\nif (d.bpm > LIMITES.bpmMax) motivos.push(`Taquicardia: ${d.bpm} bpm`);\nif (d.bpm > 0 && d.bpm < LIMITES.bpmMin) motivos.push(`Bradicardia: ${d.bpm} bpm`);\nif (d.temp > LIMITES.tempMax) motivos.push(`Febre: ${d.temp.toFixed(1)} °C`);\n\nlet estado = { cor: \"#43a047\", texto: \"NORMAL\", detalhe: `${d.bpm} bpm · ${d.temp.toFixed(1)} °C` };\nif (motivos.length) estado = { cor: \"#e53935\", texto: \"ALERTA\", detalhe: motivos.join(\" · \") };\nelse if (d.bpm === 0) estado = { cor: \"#fb8c00\", texto: \"SEM BATIMENTO\", detalhe: \"Nenhum toque nos últimos 6 s\" };\n\nconst aoVivo = d.idade_s <= AO_VIVO_S;\nconst horario = new Date(timestamp).toLocaleTimeString(\"pt-BR\");\n\nreturn [\n    { topic: \"BPM\", payload: d.bpm === 0 ? null : d.bpm, timestamp },\n    { topic: \"Temperatura\", payload: d.temp, timestamp },\n    aoVivo ? { payload: d.temp } : null,\n    aoVivo ? { payload: d.umid } : null,\n    aoVivo ? { payload: estado } : null,\n    motivos.length ? { payload: `${horario} · ${motivos.join(\" · \")}` } : null,\n    { payload: d.pendentes },\n];",
    "outputs": 7,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 200,
    "wires": [
      [
        "ch_bpm"
      ],
      [
        "ch_temp"
      ],
      [
        "ga_temp"
      ],
      [
        "ga_umid"
      ],
      [
        "led",
        "watchdog"
      ],
